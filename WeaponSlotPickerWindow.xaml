<Window x:Class="PrisonLifeMacro.WeaponSlotPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weapon Slot Setup"
        Width="520" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#151210"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#262019"/>
        <SolidColorBrush x:Key="LineBrush" Color="#30271D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#B07030"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#E8A658"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAE4DC"/>
        <SolidColorBrush x:Key="DimBrush" Color="#8F857A"/>

        <Style x:Key="SlotButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#20130A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="#7A4C20" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="18,9"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="14,7"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16" Background="{StaticResource BgBrush}"
            BorderBrush="#3A2E20" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="WEAPON SLOT SETUP" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrightBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Slot Row -->
            <StackPanel Grid.Row="1" Margin="20,8">
                <TextBlock Text="Click to select your weapon slots:" FontSize="12"
                           Foreground="#8F857A" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="Slot1" Content="1" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot2" Content="2" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot3" Content="3" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot4" Content="4" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot5" Content="5" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot6" Content="6" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot7" Content="7" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot8" Content="8" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                    <Button x:Name="Slot9" Content="9" Margin="4" Click="Slot_Click" Style="{StaticResource SlotButton}"/>
                </StackPanel>
                <TextBlock x:Name="SelectedText" Margin="0,12,0,0" FontSize="12"
                           Foreground="#8F857A" Text="Selected: 1, 2, 3" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click"
                        Style="{StaticResource AccentButton}" Margin="0,0,10,0"/>
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                        Style="{StaticResource CancelButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
