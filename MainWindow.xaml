<Window x:Class="PrisonLifeMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prison Life Macro Settings"
        Width="760" Height="952"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="False">

    <Window.Resources>

        <!-- ======================= Palette (from the logo) ======================= -->
        <SolidColorBrush x:Key="BgBrush" Color="#151210"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1D1813"/>
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#262019"/>
        <SolidColorBrush x:Key="LineBrush" Color="#30271D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#B07030"/>
        <SolidColorBrush x:Key="AccentBrightBrush" Color="#E8A658"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAE4DC"/>
        <SolidColorBrush x:Key="DimBrush" Color="#8F857A"/>
        <SolidColorBrush x:Key="RedBrush" Color="#F0433F"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFD23F"/>
        <SolidColorBrush x:Key="EditBrush" Color="#241E18"/>

        <LinearGradientBrush x:Key="HeaderGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2E2114" Offset="0"/>
            <GradientStop Color="#4A2F14" Offset="0.5"/>
            <GradientStop Color="#2E2114" Offset="1"/>
        </LinearGradientBrush>

        <!-- ======================= Section title ======================= -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}"/>
        </Style>

        <!-- ======================= Dim hint text ======================= -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ======================= Input label ======================= -->
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ======================= Text box ======================= -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource EditBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrightBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================= Check box ======================= -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                    Background="{StaticResource EditBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M 3,8.5 L 6.5,12 L 13,4.5" Stroke="{StaticResource AccentBrightBrush}"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Opacity" Value="1"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= Radio button ======================= -->
        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                    Background="{StaticResource EditBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource AccentBrightBrush}"
                                         Opacity="0" Margin="3.5"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= Round button ======================= -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="14,7"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= Accent (save) button ======================= -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#20130A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="#7A4C20" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="18,9"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= Hotkey display ======================= -->
        <Style x:Key="HotkeyDisplay" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ======================= Tab control ======================= -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="B" Background="Transparent" Padding="15,8,15,8" Margin="3,0,3,0"
                                CornerRadius="10,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontSize="12.5" FontWeight="SemiBold"/>
                                <Rectangle x:Name="Under" Height="2.5" RadiusX="1.25" RadiusY="1.25"
                                           Fill="{StaticResource AccentBrush}" Opacity="0" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Under" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource PanelRaisedBrush}"
                                    CornerRadius="12,12,0,0" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1,1,1,0" Padding="8,4,8,0">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                                    CornerRadius="0,0,12,12" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1,0,1,1" Padding="18,14">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================= Panel box ======================= -->
        <Style x:Key="PanelBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="24" Background="{StaticResource BgBrush}"
            BorderBrush="#3A2E20" BorderThickness="1">

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="132"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="92"/>
            </Grid.RowDefinitions>

            <!-- ======================= HEADER ======================= -->
            <Grid Grid.Row="0" Background="{StaticResource HeaderGlow}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Border Grid.Column="0" x:Name="LogoFrame" Width="92" Height="92" CornerRadius="20"
                        Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Margin="24,18,0,0" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect x:Name="LogoGlow" Color="#B07030" BlurRadius="20" ShadowDepth="0" Opacity="0.45"/>
                    </Border.Effect>
                    <Image x:Name="LogoImage" Width="64" Height="64" Margin="0"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" Margin="18,20,0,0">
                    <TextBlock Text="PRISON LIFE MACRO SUITE" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrightBrush}"/>
                    <TextBlock x:Name="VersionText" Text="v4.0.0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DimBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="Pressure Jump  |  Freeze  |  Rotation  |  Sprint  |  Fast Gun Swap  |  Shuffle Reload"
                               FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,9,0,0"/>
                    <TextBlock Text="Shift-tap sprint toggle   -   Global suspend key   -   One-click keybind captures"
                               FontSize="10.5" Foreground="{StaticResource DimBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Traffic-light dots (animated) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,18,20,0" VerticalAlignment="Top">
                    <Ellipse x:Name="DotMin" Width="21" Height="21" Margin="0,0,11,0"
                             Fill="{StaticResource YellowBrush}" Cursor="Hand"
                             MouseEnter="DotMin_MouseEnter" MouseLeave="DotMin_MouseLeave" MouseLeftButtonDown="DotMin_Click">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="DotMinGlow" Color="#FFD23F" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotMinScale" CenterX="10.5" CenterY="10.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="DotClose" Width="21" Height="21"
                             Fill="{StaticResource RedBrush}" Cursor="Hand"
                             MouseEnter="DotClose_MouseEnter" MouseLeave="DotClose_MouseLeave" MouseLeftButtonDown="DotClose_Click">
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="DotCloseGlow" Color="#F0433F" BlurRadius="12" ShadowDepth="0" Opacity="0"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotCloseScale" CenterX="10.5" CenterY="10.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </StackPanel>

                <!-- Animated accent divider -->
                <Grid Grid.ColumnSpan="3" Height="3" Margin="24,114,24,0" VerticalAlignment="Top">
                    <Border Background="{StaticResource LineBrush}" CornerRadius="1.5"/>
                    <Border x:Name="Shimmer" Width="240" CornerRadius="1.5" HorizontalAlignment="Left">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ShimmerT"/>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00B07030" Offset="0"/>
                                <GradientStop Color="#FFE8A658" Offset="0.5"/>
                                <GradientStop Color="#00B07030" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================= CONTENT ======================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="24,12,24,0">
                <StackPanel>

                    <!-- GLOBAL SETTINGS -->
                    <Border Style="{StaticResource PanelBox}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="GLOBAL SETTINGS" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sensitivity:" Style="{StaticResource InputLabel}"/>
                                <TextBox Grid.Column="1" x:Name="CSInput" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="2"/>
                                <TextBlock Grid.Column="3" Text="Mouse DPI:" Style="{StaticResource InputLabel}"/>
                                <TextBox Grid.Column="4" x:Name="DPIInput" Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Column="5"/>
                                <TextBlock Grid.Column="6" Text="Roblox FPS:" Style="{StaticResource InputLabel}"/>
                                <TextBox Grid.Column="7" x:Name="FPSInput" Style="{StaticResource DarkTextBox}" Width="60"/>
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="Shared by Pressure Jump and Rotation - sensitivity drives the spin/flick pixel math. DPI and FPS are stored for reference."/>
                        </StackPanel>
                    </Border>

                    <!-- MAIN GUN SLOTS -->
                    <Border Style="{StaticResource PanelBox}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="MAIN GUN SLOTS  (shared by Fast Gun Swap &amp; Shuffle Reload)"
                                       Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Gun Slots:" Style="{StaticResource InputLabel}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="GunSlotCountInput"
                                         Style="{StaticResource DarkTextBox}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Increase:" Style="{StaticResource InputLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" x:Name="IncSlotHotkeyDisplay"
                                           Style="{StaticResource HotkeyDisplay}"/>
                                <Button Grid.Row="0" Grid.Column="5" x:Name="IncSlotSetBtn" Style="{StaticResource RoundButton}"
                                        Content="Set Increase Key" Margin="12,0,0,0" Click="IncSlotSetBtn_Click"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Decrease:" Style="{StaticResource InputLabel}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="DecSlotHotkeyDisplay"
                                           Style="{StaticResource HotkeyDisplay}" Margin="0,10,0,0"/>
                                <Button Grid.Row="1" Grid.Column="5" x:Name="DecSlotSetBtn" Style="{StaticResource RoundButton}"
                                        Content="Set Decrease Key" Margin="12,10,0,0" Click="DecSlotSetBtn_Click"/>
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="Slots are the first N number-row keys (1-9, 0 = 10th slot). Both macros cycle the exact same slot list."/>
                        </StackPanel>
                    </Border>

                    <!-- GLOBAL SUSPEND -->
                    <Border Style="{StaticResource PanelBox}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="GLOBAL SUSPEND / RESUME" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Suspend Key:" Style="{StaticResource InputLabel}"/>
                                <TextBlock Grid.Column="1" x:Name="GSuspendHotkeyDisplay"
                                           Style="{StaticResource HotkeyDisplay}"/>
                                <Button Grid.Column="3" x:Name="GSuspendSetBtn" Style="{StaticResource RoundButton}"
                                        Content="Set Suspend Key" Margin="12,0,0,0" Click="GSuspendSetBtn_Click"/>
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="Press once to suspend ALL macros, press again to resume. Works from any window - even while sprinting."/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource HintText}"
                                       Text="Held sprint Shift and Freeze are released and gun-swap loops stop. Keys pass through to the game while suspended."/>
                        </StackPanel>
                    </Border>

                    <!-- TABS -->
                    <TabControl x:Name="Tabs" Style="{StaticResource DarkTabControl}"
                                Margin="0,12,0,0" Height="302">

                        <!-- Pressure Jump -->
                        <TabItem Header="Pressure Jump" Style="{StaticResource DarkTabItem}">
                            <StackPanel>
                                <CheckBox x:Name="PJEnabledCB" Style="{StaticResource DarkCheckBox}"
                                          Content="Enable Pressure Jump"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Keybind:" Style="{StaticResource InputLabel}" Width="70"/>
                                    <TextBlock x:Name="PJHotkeyDisplay" Style="{StaticResource HotkeyDisplay}" Width="150"/>
                                </StackPanel>
                                <Button x:Name="PJSetBtn" Style="{StaticResource RoundButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" Content="Click, then press key/button for Pressure Jump..."
                                        Click="PJSetBtn_Click"/>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}"
                                           Text="Hold-to-run jump. Spins the camera using the shared Sensitivity value."/>
                            </StackPanel>
                        </TabItem>

                        <!-- Freeze -->
                        <TabItem Header="Freeze" Style="{StaticResource DarkTabItem}">
                            <StackPanel>
                                <CheckBox x:Name="FreezeEnabledCB" Style="{StaticResource DarkCheckBox}"
                                          Content="Enable Freeze"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Keybind:" Style="{StaticResource InputLabel}" Width="70"/>
                                    <TextBlock x:Name="FreezeHotkeyDisplay" Style="{StaticResource HotkeyDisplay}" Width="150"/>
                                </StackPanel>
                                <Button x:Name="FreezeSetBtn" Style="{StaticResource RoundButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" Content="Click, then press key/button for Freeze..."
                                        Click="FreezeSetBtn_Click"/>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}" Text="Mode:"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="FreezeModeToggle" Style="{StaticResource DarkRadio}"
                                                 Content="Toggle (press once, again to release)" Margin="0,0,24,0"/>
                                    <RadioButton x:Name="FreezeModeHold" Style="{StaticResource DarkRadio}"
                                                 Content="Hold (frozen only while held)"/>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- Rotation -->
                        <TabItem Header="Rotation" Style="{StaticResource DarkTabItem}">
                            <StackPanel>
                                <CheckBox x:Name="RotEnabledCB" Style="{StaticResource DarkCheckBox}"
                                          Content="Enable Rotation"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Keybind:" Style="{StaticResource InputLabel}" Width="70"/>
                                    <TextBlock x:Name="RotHotkeyDisplay" Style="{StaticResource HotkeyDisplay}" Width="150"/>
                                </StackPanel>
                                <Button x:Name="RotSetBtn" Style="{StaticResource RoundButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" Content="Click, then press key/button for Rotation..."
                                        Click="RotSetBtn_Click"/>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}"
                                           Text="Wallhop flick. Camera flick pixel amount comes from the shared Sensitivity."/>
                            </StackPanel>
                        </TabItem>

                        <!-- Sprint -->
                        <TabItem Header="Sprint" Style="{StaticResource DarkTabItem}">
                            <StackPanel>
                                <CheckBox x:Name="SprEnabledCB" Style="{StaticResource DarkCheckBox}"
                                          Content="Enable Toggle Sprint"/>
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource HintText}"
                                           Text="Trigger: Shift (fixed, not rebindable)  -  active only while Roblox is focused"/>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                           Text="Tap Shift: hold Shift (sprint). Tap again: release Shift (stop). Repeats forever."/>
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                           Text="Only Shift itself is pressed - number/item slot keys and symbols are never touched."/>
                            </StackPanel>
                        </TabItem>

                        <!-- Fast Gun Swap -->
                        <TabItem Header="Fast Gun Swap" Style="{StaticResource DarkTabItem}">
                            <StackPanel>
                                <CheckBox x:Name="FGSEnabledCB" Style="{StaticResource DarkCheckBox}"
                                          Content="Enable Fast Gun Swap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Trigger:" Style="{StaticResource InputLabel}" Width="70"/>
                                    <TextBlock x:Name="FGSHotkeyDisplay" Style="{StaticResource HotkeyDisplay}" Width="150"/>
                                    <Button x:Name="FGSSetBtn" Style="{StaticResource RoundButton}"
                                            Content="Click, then press key/button for Fast Gun Swap Trigger..."
                                            Click="FGSSetBtn_Click"/>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}" Text="Mode:"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="FGSModeHold" Style="{StaticResource DarkRadio}"
                                                 Content="Hold (repeat while held)" Margin="0,0,24,0"/>
                                    <RadioButton x:Name="FGSModeToggle" Style="{StaticResource DarkRadio}"
                                                 Content="Toggle (press once to start/stop)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="On/Off Key:" Style="{StaticResource InputLabel}" Width="70"/>
                                    <TextBlock x:Name="FGSOnOffHotkeyDisplay" Style="{StaticResource HotkeyDisplay}" Width="150"/>
                                    <Button x:Name="FGSOnOffSetBtn" Style="{StaticResource RoundButton}"
                                            Content="Click, then press key/button for Fast Gun Swap On/Off..."
                                            Click="FGSOnOffSetBtn_Click"/>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}"
                                           Text="Shoot delay is fixed at 1ms. Fast Gun Swap starts OFF - press the On/Off key to arm it."/>
                            </StackPanel>
                        </TabItem>

                        <!-- Shuffle Reload -->
                        <TabItem Header="Shuffle Reload" Style="{StaticResource DarkTabItem}">
                            <StackPanel>
                                <CheckBox x:Name="SREnabledCB" Style="{StaticResource DarkCheckBox}"
                                          Content="Enable Shuffle Reload"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Trigger:" Style="{StaticResource InputLabel}" Width="70"/>
                                    <TextBlock x:Name="SRHotkeyDisplay" Style="{StaticResource HotkeyDisplay}" Width="150"/>
                                    <Button x:Name="SRSetBtn" Style="{StaticResource RoundButton}"
                                            Content="Click, then press key/button for Shuffle Reload Trigger..."
                                            Click="SRSetBtn_Click"/>
                                </StackPanel>
                                <TextBlock Margin="0,14,0,0" Style="{StaticResource HintText}"
                                           Text="Cycles the slots, pressing Reload after each one."/>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource HintText}"
                                           Text="Slot count and its +/- keys are set under Main Gun Slots above (global)."/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <Border Style="{StaticResource PanelBox}" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ABOUT &amp; UPDATES" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="Built with a real native Windows app - no AutoHotkey runtime needed."/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource HintText}"
                                       Text="Checks github.com/orbitthegreatest/PrisonLifeMacro for new releases on startup and every hour."/>
                            <Button x:Name="BtnAboutUpdates" Style="{StaticResource RoundButton}" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Content="Check for Updates" Click="BtnAboutUpdates_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ======================= FOOTER ======================= -->
            <Grid Grid.Row="2" Margin="24,8,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" x:Name="StartMinCB" Style="{StaticResource DarkCheckBox}"
                          Content="Start minimized (to tray)" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                           Style="{StaticResource HintText}"
                           Text="Target: RobloxPlayerBeta.exe   -   Settings: %localappdata%\PrisonLifeMacro\settings.ini"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnCheckUpdates" Style="{StaticResource RoundButton}" Content="Check Updates"
                            Margin="0,0,10,0" Click="BtnAboutUpdates_Click"/>
                    <Button x:Name="BtnHide" Style="{StaticResource RoundButton}" Content="Hide to Tray"
                            Margin="0,0,10,0" Click="BtnHide_Click"/>
                    <Button x:Name="BtnSave" Style="{StaticResource AccentButton}" Content="Save Settings"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>