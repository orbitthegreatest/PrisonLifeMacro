<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PrisonLifeMacro</AssemblyName>
    <RootNamespace>PrisonLifeMacro</RootNamespace>
    <ApplicationIcon>PrisonLifeMacro.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Prison Life Macro Suite</Product>
    <Version>5.2.6</Version>
    <AssemblyVersion>5.2.6.0</AssemblyVersion>
    <FileVersion>5.2.6.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PrisonLifeMacro.ico" />
    <EmbeddedResource Include="windivert\ORBPLMWinDivert.dll" LogicalName="ORBPLMDriver.dll" />
    <EmbeddedResource Include="windivert\ORBPLMWinDivert64.sys" LogicalName="ORBPLMDriver.sys" />
  </ItemGroup>

</Project>